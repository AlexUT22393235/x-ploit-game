--- !u!114 &1663981493
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1663981492}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 797ff887756073e4fa1f712171163121, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueInitializer
  initialConversation:
    conversation:
    - speakerName: Noc
      dialogueText: "\xA1Bienvenido, Snowy! Mira hacia arriba. Esa es la Torre Helada,
        nuestra \xFAnica esperanza."
      characterSprite: {fileID: 8436888122996679698, guid: 067f9efbc9adcae4aa1ef94f6d50079a, type: 3}
      position: 1
    - speakerName: Snowy
      dialogueText: "Es... enorme. \xBFDe verdad tenemos que subir todo eso antes
        de que el agua nos alcance?"
      characterSprite: {fileID: -5266207381025274554, guid: d4326784e94302243b7cda6234e91b37, type: 3}
      position: 0
    - speakerName: Noc
      dialogueText: "No hay otra. Pero t\xFA eres el mejor. Primero, mu\xE9vete:
        usa A para izquierda y D para derecha."
      characterSprite: {fileID: 8436888122996679698, guid: 067f9efbc9adcae4aa1ef94f6d50079a, type: 3}
      position: 1
    - speakerName: Noc
      dialogueText: "Ahora, practica el salto. Presiona ESPACIO. R\xE1pido, intenta
        un doble salto con Doble ESPACIO."
      characterSprite: {fileID: 8436888122996679698, guid: 067f9efbc9adcae4aa1ef94f6d50079a, type: 3}
      position: 1
    - speakerName: Snowy
      dialogueText: "\xA1Wao! Es mucho m\xE1s \xE1gil de lo que pens\xE9."
      characterSprite: {fileID: -5266207381025274554, guid: d4326784e94302243b7cda6234e91b37, type: 3}
      position: 0
    - speakerName: Noc
      dialogueText: "Bien. Recuerda: el ascenso debe ser constante. Si el agua te
        toca, la Orca te devorar\xE1."
      characterSprite: {fileID: 8436888122996679698, guid: 067f9efbc9adcae4aa1ef94f6d50079a, type: 3}
      position: 1
    - speakerName: Noc
      dialogueText: "Por \xFAltimo, tu ataque: usa Z para tu ataque principal (espada
        o Fireball, seg\xFAn tu rol)."
      characterSprite: {fileID: 8436888122996679698, guid: 067f9efbc9adcae4aa1ef94f6d50079a, type: 3}
      position: 1
    - speakerName: Noc
      dialogueText: "Si necesitas velocidad, usa X para el dash. \xA1Y domina el
        rebote en paredes! \xA1Buena suerte, Snowy!"
      characterSprite: {fileID: 8436888122996679698, guid: 067f9efbc9adcae4aa1ef94f6d50079a, type: 3}
      position: 1
  knightSprite: {fileID: -5266207381025274554, guid: d4326784e94302243b7cda6234e91b37, type: 3}
  mageSprite: {fileID: 8436888122996679698, guid: 067f9efbc9adcae4aa1ef94f6d50079a, type: 3}
